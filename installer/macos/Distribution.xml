<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- productbuild 分发描述：标准安装引导（欢迎 → 选择卷宗 → 安装） -->
<installer-gui-script minSpecVersion="2">
    <title>音乐下载器 __VERSION__</title>
    <welcome file="welcome.txt" />
    <license file="license.txt" />
    <organization>com.musicdownloader</organization>
    <options customize="never" require-scripts="false" rootVolumeOnly="true" />
    <pkg-ref id="com.musicdownloader.app"
             version="__VERSION__"
             onConclusion="none">MusicDownloader-component.pkg</pkg-ref>
    <choices-outline>
        <line choice="default">
            <line choice="com.musicdownloader.app"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.musicdownloader.app"
            visible="false"
            title="音乐下载器"
            start_selected="true">
        <pkg-ref id="com.musicdownloader.app"/>
    </choice>
</installer-gui-script>
